[Unit]
Description=value-investment portfolio input API
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/value-investment/api.env
WorkingDirectory=/opt/value-investment-api
ExecStart=/opt/value-investment-api/venv/bin/gunicorn -w 2 -b 127.0.0.1:8787 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
